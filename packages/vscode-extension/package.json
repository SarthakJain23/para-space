  "version": "0.1.0",
  "private": true,
  "publisher": "para-space",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "paraSpace.listWorktrees",
