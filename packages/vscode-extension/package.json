{
  "name": "para-space-vscode",
  "displayName": "ParaSpace",
  "description": "Parallel git worktrees with shared dependencies, per-worktree ports and window colors",
  "version": "0.1.0",
  "publisher": "para-space",
  "author": "Sarthak Jain",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/SarthakJain23/para-space.git",
    "directory": "packages/vscode-extension"
  },
  "homepage": "https://github.com/SarthakJain23/para-space#readme",
  "bugs": {
    "url": "https://github.com/SarthakJain23/para-space/issues"
  },
  "keywords": [
    "git",
    "worktree",
    "parallel",
    "workspace",
    "multi-root",
    "copilot",
    "ai-agent",
    "peacock"
  ],
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "SCM Providers",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paraSpace",
          "title": "ParaSpace",
          "icon": "media/para-space.svg"
        }
      ]
    },
    "views": {
      "paraSpace": [
        {
          "id": "paraSpace.worktrees",
          "name": "Worktrees",
          "icon": "media/para-space.svg"
        },
        {
          "id": "paraSpace.ledger",
          "name": "Context History"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paraSpace.worktrees",
        "contents": "Open a folder inside a git repository to see its worktrees.\n[Open Folder](command:vscode.openFolder)"
      },
      {
        "view": "paraSpace.ledger",
        "contents": "No context history recorded yet.\nContext is automatically recorded when worktrees are created or configured."
      }
    ],
    "commands": [
      {
        "command": "paraSpace.listWorktrees",
        "title": "List Worktrees",
        "category": "ParaSpace"
      },
      {
        "command": "paraSpace.refresh",
        "title": "Refresh",
        "category": "ParaSpace",
        "icon": "$(refresh)"
      },
      {
        "command": "paraSpace.openInNewWindow",
        "title": "Open in New Window",
        "category": "ParaSpace",
        "icon": "$(empty-window)"
      },
      {
        "command": "paraSpace.createWorktree",
        "title": "Create Worktree…",
        "category": "ParaSpace",
        "icon": "$(add)"
      },
      {
        "command": "paraSpace.selectRepositories",
        "title": "Select Repositories to Include…",
        "category": "ParaSpace",
        "icon": "$(filter)"
      },
      {
        "command": "paraSpace.configureRepo",
        "title": "Configure Port Strategy…",
        "category": "ParaSpace",
        "icon": "$(gear)"
      },
      {
        "command": "paraSpace.openLedgerFile",
        "title": "Open Context History in Editor",
        "category": "ParaSpace",
        "icon": "$(go-to-file)"
      },
      {
        "command": "paraSpace.isolateWorktree",
        "title": "Isolate Dependencies…",
        "category": "ParaSpace"
      },
      {
        "command": "paraSpace.openWorkspace",
        "title": "Open Workspace…",
        "category": "ParaSpace",
        "icon": "$(root-folder)"
      },
      {
        "command": "paraSpace.removeWorktree",
        "title": "Remove Worktree…",
        "category": "ParaSpace",
        "icon": "$(trash)"
      },
      {
        "command": "paraSpace.removeWorkspace",
        "title": "Remove Workspace…",
        "category": "ParaSpace",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "paraSpace.createWorktree",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "paraSpace.selectRepositories",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@2"
        },
        {
          "command": "paraSpace.configureRepo",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@3"
        },
        {
          "command": "paraSpace.refresh",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@4"
        },
        {
          "command": "paraSpace.openLedgerFile",
          "when": "view == paraSpace.ledger",
          "group": "navigation@1"
        },
        {
          "command": "paraSpace.refresh",
          "when": "view == paraSpace.ledger",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "paraSpace.createWorktree",
          "when": "view == paraSpace.worktrees && viewItem == paraSpace.repo",
          "group": "1_create"
        },
        {
          "command": "paraSpace.configureRepo",
          "when": "view == paraSpace.worktrees && viewItem == paraSpace.repo",
          "group": "2_config"
        },
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem == paraSpace.workspace",
          "group": "inline"
        },
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem == paraSpace.workspace",
          "group": "1_open"
        },
        {
          "command": "paraSpace.removeWorkspace",
          "when": "view == paraSpace.worktrees && viewItem == paraSpace.workspace",
          "group": "3_remove"
        },
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\./",
          "group": "inline"
        },
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\./",
          "group": "1_open"
        },
        {
          "command": "paraSpace.isolateWorktree",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\.linked\\.shared/",
          "group": "2_manage"
        },
        {
          "command": "paraSpace.isolateWorktree",
          "when": "view == paraSpace.worktrees && viewItem == worktree.linked.shared.diverged",
          "group": "inline"
        },
        {
          "command": "paraSpace.removeWorktree",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\.linked/",
          "group": "3_remove"
        },
        {
          "command": "paraSpace.openLedgerFile",
          "when": "view == paraSpace.ledger && viewItem == ledger.entry",
          "group": "inline"
        },
        {
          "command": "paraSpace.openLedgerFile",
          "when": "view == paraSpace.ledger && viewItem == paraSpace.repoLedger",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "paraSpace.openInNewWindow",
          "when": "false"
        },
        {
          "command": "paraSpace.isolateWorktree",
          "when": "false"
        },
        {
          "command": "paraSpace.removeWorktree",
          "when": "false"
        },
        {
          "command": "paraSpace.removeWorkspace",
          "when": "false"
        }
      ]
    },
    "languageModelTools": [
      {
        "name": "para_create_workspace",
        "displayName": "Create Parallel Workspace",
        "modelDescription": "Creates a parallel Git worktree or multi-repository workspace for a branch with shared dependencies, dedicated dev port, and Peacock window theme using ParaSpace.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "branch": {
              "type": "string",
              "description": "Branch name to create or checkout (e.g. feat/TK-101)"
            },
            "requirement": {
              "type": "string",
              "description": "Why this worktree or workspace exists (ticket or task description)"
            },
            "base": {
              "type": "string",
              "description": "Base ref for a new branch (default: main or current HEAD)"
            },
            "repos": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional repository paths to include for a multi-repo workspace"
            }
          },
          "required": [
            "branch"
          ]
        }
      },
      {
        "name": "para_open_workspace",
        "displayName": "Open Parallel Workspace",
        "modelDescription": "Opens an existing parallel multi-repository workspace or single worktree in VS Code by branch name, workspace name, or file path.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "description": "Branch name, workspace name, or .code-workspace file path"
            }
          },
          "required": [
            "target"
          ]
        }
      },
      {
        "name": "para_list_worktrees",
        "displayName": "List Worktrees and Workspaces",
        "modelDescription": "Lists all active Git worktrees, assigned dev server ports, and multi-repo workspaces managed by ParaSpace.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "para_isolate_worktree",
        "displayName": "Isolate Dependencies",
        "modelDescription": "Breaks away shared dependency symlinks into independent copies when manifests diverge (APFS CoW clone on macOS, fresh install elsewhere).",
        "inputSchema": {
          "type": "object",
          "properties": {
            "target": {
              "type": "string",
              "description": "Branch name, directory name or path of the worktree to isolate"
            },
            "reason": {
              "type": "string",
              "description": "Why the dependencies diverged (recorded in context history ledger)"
            }
          },
          "required": [
            "target"
          ]
        }
      }
    ]
  },
  "scripts": {
    "build": "tsup",
    "package": "pnpm build && npx @vscode/vsce package --no-dependencies",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@para-space/core": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0"
  }
}
