{
  "name": "para-space-vscode",
  "displayName": "ParaSpace",
  "description": "Parallel git worktrees with shared dependencies, per-worktree ports and window colors",
  "version": "0.1.0",
  "private": true,
  "publisher": "para-space",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "paraSpace",
          "title": "ParaSpace",
          "icon": "media/para-space.svg"
        }
      ]
    },
    "views": {
      "paraSpace": [
        {
          "id": "paraSpace.worktrees",
          "name": "Worktrees",
          "icon": "media/para-space.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "paraSpace.worktrees",
        "contents": "Open a folder inside a git repository to see its worktrees.\n[Open Folder](command:vscode.openFolder)"
      }
    ],
    "commands": [
      {
        "command": "paraSpace.listWorktrees",
        "title": "List Worktrees",
        "category": "ParaSpace"
      },
      {
        "command": "paraSpace.refresh",
        "title": "Refresh",
        "category": "ParaSpace",
        "icon": "$(refresh)"
      },
      {
        "command": "paraSpace.openInNewWindow",
        "title": "Open in New Window",
        "category": "ParaSpace",
        "icon": "$(empty-window)"
      },
      {
        "command": "paraSpace.createWorktree",
        "title": "Create Worktree…",
        "category": "ParaSpace",
        "icon": "$(add)"
      },
      {
        "command": "paraSpace.isolateWorktree",
        "title": "Isolate Dependencies…",
        "category": "ParaSpace"
      },
      {
        "command": "paraSpace.removeWorktree",
        "title": "Remove Worktree…",
        "category": "ParaSpace",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "paraSpace.createWorktree",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@1"
        },
        {
          "command": "paraSpace.refresh",
          "when": "view == paraSpace.worktrees",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\./",
          "group": "inline"
        },
        {
          "command": "paraSpace.openInNewWindow",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\./",
          "group": "1_open"
        },
        {
          "command": "paraSpace.isolateWorktree",
          "when": "view == paraSpace.worktrees && viewItem == worktree.linked.shared",
          "group": "2_manage"
        },
        {
          "command": "paraSpace.removeWorktree",
          "when": "view == paraSpace.worktrees && viewItem =~ /^worktree\\.linked/",
          "group": "3_remove"
        }
      ],
      "commandPalette": [
        {
          "command": "paraSpace.openInNewWindow",
          "when": "false"
        },
        {
          "command": "paraSpace.isolateWorktree",
          "when": "false"
        },
        {
          "command": "paraSpace.removeWorktree",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@para-space/core": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/vscode": "~1.90.0"
  }
}
