{
  "name": "para-space",
  "private": true,
  "description": "Parallel workspace orchestrator for multi-agent and multi-task IDE workflows",
  "license": "MIT",
  "author": "Sarthak Jain",
  "repository": {
    "type": "git",
    "url": "https://github.com/SarthakJain23/para-space.git"
  },
  "homepage": "https://github.com/SarthakJain23/para-space#readme",
  "bugs": {
    "url": "https://github.com/SarthakJain23/para-space/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm --filter @para-space/core build && pnpm -r typecheck",
    "test": "vitest run",
    "lint": "eslint \"packages/**/*.ts\" --max-warnings=0",
    "package:extension": "pnpm --filter para-space-vscode package",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "eslint": "^10.13.0",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "simple-git-hooks": "^2.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
